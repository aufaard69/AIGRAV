<Window x:Class="AIGRAV.RevitBridge.AIGRAVWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIGRAV"
        Width="920"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

	<Border
        CornerRadius="18"
        Background="#0A111D"
        BorderBrush="#2A405E"
        BorderThickness="1">

		<Grid>

			<!-- HEADER -->
			<Border
                Height="62"
                VerticalAlignment="Top"
                Background="#0D1725"
                CornerRadius="18,18,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

				<Grid Margin="22,0">

					<StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

						<Border
                            Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="#10213A">

							<Image
                                Source="/AIGRAV.RevitBridge;component/Assets/AIGRAV_Gemini_Icon.png"
                                Margin="4"/>
						</Border>

						<TextBlock
                            Text="AIGRAV"
                            Margin="11,0,0,0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center"/>

						<Border
                            Margin="12,0,0,0"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="#10294A"
                            BorderBrush="#244B7C"
                            BorderThickness="1"
                            VerticalAlignment="Center">
							<TextBlock
                                Text="AI BRIDGE CONTROLLER"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#54A8FF"/>
						</Border>

					</StackPanel>

					<Button
                        Content="×"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#91A2B8"
                        FontSize="25"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

				</Grid>

			</Border>

			<!-- MAIN -->
			<Grid Margin="0,62,0,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="42*"/>
					<ColumnDefinition Width="58*"/>
				</Grid.ColumnDefinitions>

				<!-- LEFT BRANDING PANEL -->
				<Border
                    Grid.Column="0"
                    Background="#071525"
                    CornerRadius="0,0,0,18">

					<Grid>

						<Ellipse
                            Width="350"
                            Height="350"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
							<Ellipse.Fill>
								<RadialGradientBrush>
									<GradientStop Color="#173B76" Offset="0"/>
									<GradientStop Color="#0C213E" Offset="0.55"/>
									<GradientStop Color="#071525" Offset="1"/>
								</RadialGradientBrush>
							</Ellipse.Fill>
						</Ellipse>

						<StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

							<Border
                                Width="145"
                                Height="145"
                                CornerRadius="28"
                                Background="#0D2343"
                                BorderBrush="#2D6AB0"
                                BorderThickness="1">
								<Image
                                    Source="/AIGRAV.RevitBridge;component/Assets/AIGRAV_Gemini_Icon.png"
                                    Margin="18"/>
							</Border>

							<TextBlock
                                Text="AIGRAV"
                                Margin="0,24,0,0"
                                FontSize="40"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"/>

							<TextBlock
                                Text="AI BRIDGE FOR AUTODESK REVIT"
                                Margin="0,5,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#718AA9"
                                HorizontalAlignment="Center"/>

							<TextBlock
                                Text="Gemini + MCP Server + C# API"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                FontSize="11"
                                Foreground="#6C829F"/>

							<TextBlock
                                Text="Developed by Aufaard"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"
                                FontSize="12"
                                Foreground="White"/>

						</StackPanel>

					</Grid>

				</Border>

				<!-- RIGHT CONTROLLER PANEL -->
				<Border
                    Grid.Column="1"
                    Background="#0B1421"
                    CornerRadius="0,0,18,0">

					<StackPanel Margin="36,30,36,24" VerticalAlignment="Center">

						<TextBlock FontSize="30" FontWeight="Bold">
							<Run Text="AIGRAV is " Foreground="White"/>
							<Run Text="AI ANTIGRAVITY" Foreground="#54A8FF"/>
						</TextBlock>

						<TextBlock
                            Text="AI Bridge for Autodesk Revit • Interactive Port &amp; Connection Control"
                            Margin="0,6,0,0"
                            FontSize="13.5"
                            Foreground="#A8B8CC"/>

						<!-- HTTP SERVER BRIDGE CONTROL CARD -->
						<Border
                            Margin="0,22,0,0"
                            Padding="18"
                            CornerRadius="13"
                            Background="#0E1928"
                            BorderBrush="#26394F"
                            BorderThickness="1">

							<StackPanel>

								<!-- Card Title + Connection Pill -->
								<Grid Margin="0,0,0,14">
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<TextBlock Text="▣" FontSize="14" Foreground="#DCE6F3" Margin="0,0,8,0"/>
										<TextBlock Text="HTTP Server Bridge" FontSize="14" FontWeight="SemiBold" Foreground="#DCE6F3"/>
									</StackPanel>

									<Border x:Name="ConnectionBadgeBorder"
                                            HorizontalAlignment="Right"
                                            Padding="10,4"
                                            CornerRadius="12"
                                            Background="#0E291D"
                                            BorderBrush="#1F5D3E"
                                            BorderThickness="1">
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<Ellipse x:Name="ConnectionBadgeDot"
                                                     Width="7"
                                                     Height="7"
                                                     Fill="#32D583"
                                                     Margin="0,0,6,0"/>
											<TextBlock x:Name="ConnectionBadgeText"
                                                       Text="Connected"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#48F09B"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- Port Listener Controls -->
								<Grid Margin="0,0,0,14">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<TextBlock Grid.Column="0"
                                               Text="Port Listener:"
                                               FontSize="12.5"
                                               Foreground="#A8B8CC"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

									<Border Grid.Column="1"
                                            Background="#08111D"
                                            BorderBrush="#2A405E"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Width="72"
                                            Height="34"
                                            Margin="0,0,10,0">
										<TextBox x:Name="PortTextBox"
                                                 Text="8765"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="14"
                                                 FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="#54A8FF"
                                                 MaxLength="5"
                                                 KeyDown="PortTextBox_KeyDown"/>
									</Border>

									<Button x:Name="TestConnectionButton"
                                            Grid.Column="2"
                                            Content="⚡ Test Connection"
                                            Height="34"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Background="#1976D2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="TestConnectionButton_Click">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,0">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Button.Template>
									</Button>

									<Button x:Name="FindFreePortButton"
                                            Grid.Column="3"
                                            Content="Cari Port Bebas (+1)"
                                            Height="34"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#DCE6F3"
                                            Background="#162438"
                                            BorderBrush="#2A405E"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Click="FindFreePortButton_Click">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7"
                                                        Padding="10,0">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</Grid>

								<!-- Live Bridge Status Strip -->
								<Border x:Name="BridgeStatusBanner"
                                        Padding="12,9"
                                        CornerRadius="8"
                                        Background="#0E291D"
                                        BorderBrush="#1F5D3E"
                                        BorderThickness="1">
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<Ellipse x:Name="StatusBannerDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#32D583"
                                                 Margin="0,0,8,0"/>
										<TextBlock x:Name="StatusBannerText"
                                                   Text="Bridge Connected di http://127.0.0.1:8765/ • Siap melayani instruksi AI Revit."
                                                   FontSize="12"
                                                   Foreground="#6CE9A6"
                                                   TextTrimming="CharacterEllipsis"/>
									</StackPanel>
								</Border>

								<!-- Telemetry Footer Row -->
								<Grid Margin="0,12,0,0">
									<TextBlock x:Name="TelemetryText"
                                               Text="URL: http://127.0.0.1:8765/ • Revit PID: - • Requests: 0 served"
                                               FontSize="11"
                                               Foreground="#7D93AE"
                                               VerticalAlignment="Center"/>

									<Button x:Name="RestartBridgeButton"
                                            Content="Restart Bridge"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#54A8FF"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="RestartBridgeButton_Click"/>
								</Grid>

							</StackPanel>

						</Border>

						<!-- UPDATE NOTIFICATION BANNER (NON-INTRUSIVE) -->
						<Border x:Name="UpdateBanner"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Padding="12,10"
                                CornerRadius="8"
                                Background="#1A2D23"
                                BorderBrush="#32D583"
                                BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock x:Name="UpdateTitleText"
                                               Text="✨ Pembaruan AIGRAV Tersedia"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#48F09B"/>
									<TextBlock x:Name="UpdateSubText"
                                               Text="Klik untuk melihat fitur baru"
                                               FontSize="10"
                                               Foreground="#A3C2B0"/>
								</StackPanel>
								<Button x:Name="ViewUpdateButton"
                                        Grid.Column="1"
                                        Content="Lihat Detail"
                                        Padding="10,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Background="#2E90FA"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ViewUpdateButton_Click">
									<Button.Template>
										<ControlTemplate TargetType="Button">
											<Border Background="{TemplateBinding Background}" CornerRadius="5">
												<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,3"/>
											</Border>
										</ControlTemplate>
									</Button.Template>
								</Button>
							</Grid>
						</Border>

						<!-- PRIMARY ACTION BUTTON -->
						<Button
                            Content="Tutup Jendela (AIGRAV Tetap Berjalan)"
                            Height="46"
                            Margin="0,18,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1976D2"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LaunchButton_Click">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" CornerRadius="9">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<TextBlock x:Name="FooterVersionText"
                            Text="AIGRAV v3.2.0  •  Gemini + MCP + Revit API • Aufa Ardianto"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            FontSize="10.5"
                            Foreground="#5C718C"/>

					</StackPanel>

				</Border>

			</Grid>

		</Grid>

	</Border>

</Window>
