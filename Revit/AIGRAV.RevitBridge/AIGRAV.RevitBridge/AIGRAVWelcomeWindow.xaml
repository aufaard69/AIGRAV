<Window x:Class="AIGRAV.RevitBridge.AIGRAVWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIGRAV"
        Width="940"
        Height="590"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

	<Border
        CornerRadius="18"
        Background="#0A111D"
        BorderBrush="#2A405E"
        BorderThickness="1">

		<Grid>

			<!-- HEADER -->

			<Border
                Height="58"
                VerticalAlignment="Top"
                Background="#0D1725"
                CornerRadius="18,18,0,0">

				<Grid Margin="22,0">

					<StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

						<Border
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="#10213A">

							<Image
                                Source="/AIGRAV.RevitBridge;component/Assets/AIGRAV_Gemini_Icon.png"
                                Margin="4"/>
						</Border>

						<TextBlock
                            Text="AIGRAV"
                            Margin="11,0,0,0"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center"/>

						<Border
                            Margin="12,0,0,0"
                            Padding="8,2"
                            CornerRadius="6"
                            Background="#162D4A"
                            VerticalAlignment="Center">
							<TextBlock
                                Text="AI BRIDGE CONTROLLER"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#54A8FF"/>
						</Border>

					</StackPanel>

					<Button
                        Content="×"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#91A2B8"
                        FontSize="24"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

				</Grid>

			</Border>


			<!-- MAIN CONTENT -->

			<Grid Margin="0,58,0,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="40*"/>
					<ColumnDefinition Width="60*"/>
				</Grid.ColumnDefinitions>


				<!-- LEFT COLUMN (BRANDING & INFO) -->

				<Border
                    Grid.Column="0"
                    Background="#071525"
                    CornerRadius="0,0,0,18">

					<Grid>

						<Ellipse
                            Width="320"
                            Height="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

							<Ellipse.Fill>
								<RadialGradientBrush>
									<GradientStop Color="#173B76" Offset="0"/>
									<GradientStop Color="#0C213E" Offset="0.55"/>
									<GradientStop Color="#071525" Offset="1"/>
								</RadialGradientBrush>
							</Ellipse.Fill>

						</Ellipse>


						<StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

							<Border
                                Width="135"
                                Height="135"
                                CornerRadius="26"
                                Background="#0D2343"
                                BorderBrush="#2D6AB0"
                                BorderThickness="1">

								<Image
                                    Source="/AIGRAV.RevitBridge;component/Assets/AIGRAV_Gemini_Icon.png"
                                    Margin="16"/>

							</Border>


							<TextBlock
                                Text="AIGRAV"
                                Margin="0,20,0,0"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"/>


							<TextBlock
                                Text="AI BRIDGE FOR AUTODESK REVIT"
                                Margin="0,4,0,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#718AA9"
                                HorizontalAlignment="Center"/>

							<TextBlock
                                Text="Gemini + MCP Server + C# API"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="#5C718C"/>

							<TextBlock
                                Text="Developed by Aufaard"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="#A0B3CC"/>

						</StackPanel>

					</Grid>

				</Border>


				<!-- RIGHT COLUMN (INTERACTIVE BRIDGE CONTROLS) -->

				<Border
                    Grid.Column="1"
                    Background="#0B1421"
                    CornerRadius="0,0,18,0">

					<StackPanel Margin="32,24,32,20">

						<!-- TITLE -->
						<Grid>
							<StackPanel>
								<TextBlock FontSize="24" FontWeight="Bold">
									<Run Text="AIGRAV is " Foreground="White"/>
									<Run Text="AI ANTIGRAVITY" Foreground="#54A8FF"/>
								</TextBlock>
								<TextBlock
                                    Text="AI Bridge for Autodesk Revit • Interactive Port &amp; Connection Control"
                                    Margin="0,3,0,0"
                                    FontSize="13"
                                    Foreground="#A8B8CC"/>
							</StackPanel>
						</Grid>

						<Border
                            Height="1"
                            Background="#1E2F46"
                            Margin="0,14,0,14"/>

						<!-- INTERACTIVE BRIDGE STATUS & PORT CONTROL CARD -->
						<Border
                            Padding="16,14"
                            CornerRadius="12"
                            Background="#0E1928"
                            BorderBrush="#26394F"
                            BorderThickness="1">

							<StackPanel>

								<!-- CARD HEADER: BRIDGE NAME + DYNAMIC STATUS BADGE -->
								<Grid>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<TextBlock
                                            Text="▣   HTTP Server Bridge"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#DCE6F3"
                                            VerticalAlignment="Center"/>
									</StackPanel>

									<!-- DYNAMIC CONNECTION BADGE -->
									<Border x:Name="StatusBadgeBorder"
                                            HorizontalAlignment="Right"
                                            Padding="10,4"
                                            CornerRadius="12"
                                            Background="#132B20"
                                            BorderBrush="#1B4D36"
                                            BorderThickness="1">
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<Ellipse x:Name="StatusDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="#32D583"
                                                     Margin="0,0,6,0"/>
											<TextBlock x:Name="StatusLabel"
                                                       Text="Connected"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#32D583"/>
										</StackPanel>
									</Border>
								</Grid>

								<!-- PORT CONFIGURATION & TEST CONTROLS -->
								<Border
                                    Margin="0,14,0,0"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Background="#071322"
                                    BorderBrush="#1A2D46"
                                    BorderThickness="1">

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>

										<TextBlock
                                            Grid.Column="0"
                                            Text="Port Listener:"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#8FA5C0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>

										<!-- PORT INPUT TEXTBOX -->
										<TextBox x:Name="PortInput"
                                                 Grid.Column="1"
                                                 Text="8765"
                                                 Width="75"
                                                 Height="30"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="13"
                                                 FontWeight="Bold"
                                                 Foreground="White"
                                                 Background="#0D1F35"
                                                 BorderBrush="#2A405E"
                                                 BorderThickness="1"
                                                 Margin="0,0,10,0"
                                                 ToolTip="Ketik nomor port lokal bridge Revit (default: 8765)"/>

										<!-- TEST CONNECTION BUTTON -->
										<Button x:Name="TestConnectionButton"
                                                Grid.Column="2"
                                                Content="⚡ Test Connection"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Background="#1570EF"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="TestConnectionButton_Click"
                                                ToolTip="Uji ketersediaan port dan hubungkan HTTP bridge">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}" CornerRadius="6">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

										<!-- AUTO NEXT PORT BUTTON -->
										<Button x:Name="AutoPortButton"
                                                Grid.Column="3"
                                                Content="Cari Port Bebas (+1)"
                                                Height="30"
                                                Padding="10,0"
                                                Margin="8,0,0,0"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Foreground="#CBD5E1"
                                                Background="#1E2D40"
                                                BorderBrush="#33465E"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Click="AutoPortButton_Click"
                                                ToolTip="Cari dan atur port kosong berikutnya secara otomatis">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

									</Grid>

								</Border>

								<!-- FEEDBACK & DIAGNOSTIC STATUS MESSAGE BOX -->
								<Border x:Name="FeedbackBorder"
                                        Margin="0,12,0,0"
                                        Padding="12,9"
                                        CornerRadius="8"
                                        Background="#0E291C"
                                        BorderBrush="#1B4D36"
                                        BorderThickness="1">
									<TextBlock x:Name="StatusDetailText"
                                               Text="🟢 Bridge aktif pada http://127.0.0.1:8765/ • Siap melayani perintah AI Revit."
                                               FontSize="11"
                                               LineHeight="16"
                                               TextWrapping="Wrap"
                                               Foreground="#48F09B"/>
								</Border>

								<!-- DIAGNOSTIC METRICS ROW -->
								<Grid Margin="0,12,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock x:Name="MetricsText"
                                                   Text="URL: http://127.0.0.1:8765/  •  Revit PID: --  •  Requests: 0 served"
                                                   FontSize="10"
                                                   Foreground="#607694"/>
									</StackPanel>

									<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
										<Button x:Name="ToggleBridgeButton"
                                                Content="Restart Bridge"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#54A8FF"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="ToggleBridgeButton_Click"/>
									</StackPanel>
								</Grid>

							</StackPanel>

						</Border>


						<!-- UPDATE NOTIFICATION BANNER (NON-INTRUSIVE) -->
						<Border x:Name="UpdateBanner"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Padding="12,9"
                                CornerRadius="8"
                                Background="#1A2D23"
                                BorderBrush="#32D583"
                                BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock x:Name="UpdateTitleText"
                                               Text="✨ Pembaruan AIGRAV Tersedia"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#48F09B"/>
									<TextBlock x:Name="UpdateSubText"
                                               Text="Klik untuk melihat fitur baru"
                                               FontSize="10"
                                               Foreground="#A3C2B0"/>
								</StackPanel>
								<Button x:Name="ViewUpdateButton"
                                        Grid.Column="1"
                                        Content="Lihat Detail"
                                        Padding="10,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Background="#2E90FA"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ViewUpdateButton_Click">
									<Button.Template>
										<ControlTemplate TargetType="Button">
											<Border Background="{TemplateBinding Background}" CornerRadius="5">
												<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,3"/>
											</Border>
										</ControlTemplate>
									</Button.Template>
								</Button>
							</Grid>
						</Border>


						<!-- CLOSE / HIDE BUTTON -->

						<Button
                            Content="Tutup Jendela (AIGRAV Tetap Berjalan)"
                            Height="42"
                            Margin="0,16,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1E3A5F"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LaunchButton_Click">

							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" CornerRadius="8">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>

						</Button>


						<TextBlock x:Name="FooterVersionText"
                            Text="AIGRAV v3.0.0  •  Gemini + MCP + Revit API • Aufa Ardianto"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            FontSize="10"
                            Foreground="#4B5E78"/>

					</StackPanel>

				</Border>

			</Grid>

		</Grid>

	</Border>

</Window>
