<UserControl x:Class="AIGRAV.RevitBridge.UI.RebarSuite.RebarBrowserPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A111D"
             Foreground="#E2E8F0"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="PaneBtn" TargetType="Button">
            <Setter Property="Background" Value="#152338"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#26394F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3554"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="REINFORCEMENT BROWSER" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock x:Name="SummaryText" Text="0 reinforced hosts scanned (Offline)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="Refresh" Style="{StaticResource PaneBtn}" Click="OnRefreshClick"/>
            <Button Content="Select" Style="{StaticResource PaneBtn}" Click="OnSelectClick"/>
            <Button Content="Isolate" Style="{StaticResource PaneBtn}" Click="OnIsolateClick"/>
            <Button Content="Open Studio" Style="{StaticResource PaneBtn}" Background="#143A52" BorderBrush="#38BDF8" Click="OnOpenStudioClick"/>
            <Button Content="Update Modified" Style="{StaticResource PaneBtn}" Background="#3D2B10" BorderBrush="#FBBF24" Foreground="#FDE68A" Click="OnUpdateModifiedClick"/>
        </WrapPanel>

        <DataGrid x:Name="BrowserGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  Background="#0D1725"
                  Foreground="#E2E8F0"
                  RowBackground="#0F1A2B"
                  AlternatingRowBackground="#122033"
                  BorderBrush="#26394F"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1D2D44"
                  HeadersVisibility="Column"
                  FontSize="11">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#132238"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="6,5"/>
                    <Setter Property="BorderBrush" Value="#26394F"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="68"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="*"/>
                <DataGridTextColumn Header="Marks" Binding="{Binding MarkSummary}" Width="78"/>
                <DataGridTextColumn Header="Bars" Binding="{Binding BarCount}" Width="42"/>
                <DataGridTextColumn Header="kg" Binding="{Binding WeightKg, StringFormat=N1}" Width="56"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="64"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusFooter"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="10.5"
                   Foreground="#64748B"
                   Text="Double-click a host row to select in Revit."/>
    </Grid>
</UserControl>
