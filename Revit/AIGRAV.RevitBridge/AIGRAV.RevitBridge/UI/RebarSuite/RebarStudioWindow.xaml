<Window x:Class="AIGRAV.RevitBridge.UI.RebarSuite.RebarStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIGRAV Rebar Suite — Offline Structural Reinforcement Studio"
        Width="1340"
        Height="840"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0A111D"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCanvas" Color="#0A111D"/>
        <SolidColorBrush x:Key="BgCard" Color="#0F1A2B"/>
        <SolidColorBrush x:Key="BgInput" Color="#152338"/>
        <SolidColorBrush x:Key="BorderDark" Color="#24364E"/>
        <SolidColorBrush x:Key="TextMain" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="#152338"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#26394F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3554"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCtaBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="#0E7490"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AIGRAV REBAR SUITE" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                    <Border Background="#0D2F26" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                        <TextBlock Text="100% OFFLINE • DETERMINISTIC C# ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Content Pack:" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="PresetComboBox" Width="210" Margin="0,0,6,0" SelectionChanged="OnPresetChanged"/>
                    <Button Content="Save Preset" Style="{StaticResource FlatBtn}" Margin="0,0,6,0" Click="OnSavePresetClick"/>
                    <Button Content="Save to Model" Style="{StaticResource FlatBtn}" Margin="0,0,10,0" Click="OnSaveToModelClick"/>
                    <CheckBox x:Name="AutoSyncCheckBox" Content="Auto-Sync Selection" IsChecked="True" Foreground="#38BDF8" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: GLOBAL STOCK & CODE STRIP -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="10,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                    <TextBlock Text="Max Stock (mm):" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="MaxStockCombo" Width="76" IsEditable="True" Text="12000" SelectionChanged="OnRuleChanged" LostFocus="OnRuleTextLostFocus">
                        <ComboBoxItem Content="6000"/>
                        <ComboBoxItem Content="9000"/>
                        <ComboBoxItem Content="12000" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                    <TextBlock Text="Overlap:" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="LapModeCombo" Width="92" SelectionChanged="OnRuleChanged">
                        <ComboBoxItem Content="40D" Tag="D40" IsSelected="True"/>
                        <ComboBoxItem Content="50D" Tag="D50"/>
                        <ComboBoxItem Content="60D" Tag="D60"/>
                        <ComboBoxItem Content="Custom mm" Tag="CustomMm"/>
                        <ComboBoxItem Content="Coupler (0)" Tag="Coupler"/>
                    </ComboBox>
                    <TextBox x:Name="CustomLapBox" Width="54" Text="800" Margin="4,0,0,0" ToolTip="Custom overlap (mm)" LostFocus="OnRuleTextLostFocus"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                    <TextBlock Text="Bond:" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="BondCombo" Width="88" SelectionChanged="OnRuleChanged">
                        <ComboBoxItem Content="Good (1.0x)" Tag="Good" IsSelected="True"/>
                        <ComboBoxItem Content="Poor (1.3x)" Tag="Poor"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                    <TextBlock Text="Round:" Style="{StaticResource Lbl}"/>
                    <ComboBox x:Name="RoundingCombo" Width="72" SelectionChanged="OnRuleChanged">
                        <ComboBoxItem Content="1 mm" Tag="Nearest1Mm"/>
                        <ComboBoxItem Content="25 mm" Tag="Nearest25Mm" IsSelected="True"/>
                        <ComboBoxItem Content="50 mm" Tag="Nearest50Mm"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="StaggerCheck" Content="Stagger 50%" IsChecked="True" Margin="0,2,10,2" Click="OnRuleCheckChanged"/>
                <CheckBox x:Name="MomentSafeCheck" Content="Moment-Safe Cut" IsChecked="True" Margin="0,2,10,2" Click="OnRuleCheckChanged"/>
                <CheckBox x:Name="ConstraintsCheck" Content="Rebar Constraints" IsChecked="True" Margin="0,2,10,2" Click="OnRuleCheckChanged"/>
                <CheckBox x:Name="ColorByDiaCheck" Content="Color by Dia" IsChecked="True" Margin="0,2,10,2" Click="OnRuleCheckChanged"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Lokasi:" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="LokasiBox" Width="105" ToolTip="Optional QTO/BBS Lokasi zone (blank = Level name)" LostFocus="OnRuleTextLostFocus"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ROW 2: MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: SELECTION QUEUE + CATEGORY RULES -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="195"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SELECTION QUEUE -->
                <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="SELECTED HOSTS" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="SelectionCountBadge" Text=" (0)" FontSize="11.5" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Pick in Revit" Style="{StaticResource FlatBtn}" Padding="7,3" FontSize="10.5" Margin="0,0,4,0" Click="OnPickInRevitClick"/>
                                <Button Content="Sync" Style="{StaticResource FlatBtn}" Padding="7,3" FontSize="10.5" Click="OnSyncSelectionClick"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SelectionQueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#122033" BorderBrush="#1F324B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" Click="OnHostIncludeToggled" Margin="0,0,6,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding FamilyAndType}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="#94A3B8">
                                                        <Run Text="{Binding CategoryDisplay}"/> •
                                                        <Run Text="{Binding WidthMm, StringFormat=N0}"/>×<Run Text="{Binding DepthOrThicknessMm, StringFormat=N0}"/> •
                                                        L=<Run Text="{Binding SpanOrHeightMm, StringFormat=N0}"/>mm
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding LevelName}" FontSize="10" Foreground="#38BDF8" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- CATEGORY RULES TABS -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0">
                    <TabControl x:Name="CategoryTabControl" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#132238"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#26394F" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1B3654"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- TAB 1: BALOK (BEAM) -->
                        <TabItem Header="Balok">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,4,2">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Selimut Beton (mm):" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="BeamCoverBox" Grid.Column="1" Text="40" LostFocus="OnRuleTextLostFocus"/>
                                    </Grid>
                                    <TextBlock Text="TULANGAN UTAMA MENERUS" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Atas Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamTopDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Jml:" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamTopCountBox" Text="3" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Bawah Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamBotDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Jml:" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamBotCountBox" Text="3" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="KAIT JOINT BALOK-KOLOM EKSTERIOR" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <ComboBox x:Name="BeamJointHookCombo" Margin="0,0,4,0" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="90° Joint Core" Tag="Bend90Inward" IsSelected="True"/>
                                            <ComboBoxItem Content="U-Hairpin" Tag="UHairpin"/>
                                            <ComboBoxItem Content="Lurus (Straight)" Tag="Straight"/>
                                        </ComboBox>
                                        <ComboBox x:Name="BeamHookFormulaCombo" Margin="4,0,0,0" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="h - 2c (Penuh)" Tag="h-2c" IsSelected="True"/>
                                            <ComboBoxItem Content="12D (SNI Min)" Tag="12D"/>
                                            <ComboBoxItem Content="15D" Tag="15D"/>
                                        </ComboBox>
                                    </UniformGrid>

                                    <TextBlock Text="TULANGAN EXTRA &amp; PEMUTUSAN (SNI 2847)" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,4"/>
                                    <CheckBox x:Name="BeamExtraTopCheck" Content="Extra Atas Tumpuan (Semua As, L/4 + l_ext)" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <UniformGrid Columns="2" Margin="0,2,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamExtraTopDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Jml:" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamExtraTopCountBox" Text="2" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <CheckBox x:Name="BeamExtraBotCheck" Content="Extra Bawah Lapangan (Tiap Span, L/2 + 2·l_ext)" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <UniformGrid Columns="2" Margin="0,2,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamExtraBotDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Jml:" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamExtraBotCountBox" Text="2" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Panjang Ekstensi l_ext:" Style="{StaticResource Lbl}"/>
                                        <ComboBox x:Name="BeamCutoffModeCombo" Grid.Column="1" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="SNI max(d, 12D)" Tag="SniMaxDOr12D" IsSelected="True"/>
                                            <ComboBoxItem Content="20D (Konservatif)" Tag="L20D"/>
                                            <ComboBoxItem Content="0 mm (Murni L/4 &amp; L/2)" Tag="Zero"/>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="BeamSkinCheck" Content="Tulangan Pinggang / Skin (h ≥ 700mm)" IsChecked="False" Click="OnRuleCheckChanged"/>
                                    <UniformGrid Columns="2" Margin="0,2,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamSkinDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Pasang:" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamSkinPairsBox" Text="1" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="SENGKANG 3 ZONA (TUMPUAN / LAPANGAN)" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Dia:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamStirrupDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Kaki:" Style="{StaticResource Lbl}"/><ComboBox x:Name="BeamStirrupLegsCombo" SelectionChanged="OnRuleChanged"><ComboBoxItem Content="2" IsSelected="True"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Tump (mm):" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamStirrupTumpBox" Text="100" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Lap (mm):" Style="{StaticResource Lbl}"/><TextBox x:Name="BeamStirrupLapBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Zona Sengkang:" Style="{StaticResource Lbl}"/>
                                        <ComboBox x:Name="BeamStirrupZoneModeCombo" Grid.Column="1" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="1/4 Tumpuan — 1/2 Lapangan" Tag="QuarterSpan_L4_L2_L4" IsSelected="True"/>
                                            <ComboBoxItem Content="SNI SRPMK max(2h, L/4)" Tag="SniSrpmkMax2hOrL4"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="BeamSeismic135Check" Content="Kait Sengkang Gempa 135° (SNI)" IsChecked="True" Click="OnRuleCheckChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: KOLOM (COLUMN) -->
                        <TabItem Header="Kolom">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,4,2">
                                <StackPanel>
                                    <Border Background="#0E2538" BorderBrush="#1F4B6E" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#BAE6FD"
                                                   Text="Tulangan kolom dimulai dari tekukan 90° di dasar pondasi (tanpa stek ganda di pondasi) hingga kait atap."/>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Cover:" Style="{StaticResource Lbl}"/><TextBox x:Name="ColCoverBox" Text="40" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Dia Utama:" Style="{StaticResource Lbl}"/><ComboBox x:Name="ColMainDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Total Btg:" Style="{StaticResource Lbl}"/><TextBox x:Name="ColMainCountBox" Text="8" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Dia Sengk:" Style="{StaticResource Lbl}"/><ComboBox x:Name="ColTieDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="STRATEGI SAMBUNGAN VERTIKAL" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                    <ComboBox x:Name="ColSpliceStrategyCombo" Margin="0,0,0,6" SelectionChanged="OnRuleChanged">
                                        <ComboBoxItem Content="Auto (Ikuti Potongan Model)" Tag="AutoFollowModelCut" IsSelected="True"/>
                                        <ComboBoxItem Content="Paksa Sambung Tiap Lantai" Tag="ForceSplicePerLevel"/>
                                        <ComboBoxItem Content="Optimasi Menerus 12m" Tag="OptimizeFull12m"/>
                                    </ComboBox>

                                    <TextBlock Text="TEKUKAN DASAR PONDASI &amp; ATAP" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Kait Bawah:" Style="{StaticResource Lbl}"/><ComboBox x:Name="ColBaseBendCombo" SelectionChanged="OnRuleChanged"><ComboBoxItem Content="90° Keluar" Tag="Bend90Outward" IsSelected="True"/><ComboBoxItem Content="90° Kedalam" Tag="Bend90Inward"/><ComboBoxItem Content="Lurus" Tag="Straight"/></ComboBox></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Kaki (mm):" Style="{StaticResource Lbl}"/><TextBox x:Name="ColBaseBendLegBox" Text="300" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Duduk Mat:" Style="{StaticResource Lbl}"/><TextBox x:Name="ColFootEmbedBox" Text="100" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Kait Atap:" Style="{StaticResource Lbl}"/><ComboBox x:Name="ColRoofHookCombo" SelectionChanged="OnRuleChanged"><ComboBoxItem Content="90° Kedalam" Tag="Bend90Inward" IsSelected="True"/><ComboBoxItem Content="90° Keluar" Tag="Bend90Outward"/><ComboBoxItem Content="Lurus" Tag="Straight"/></ComboBox></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="SENGKANG (l_o, TENGAH &amp; DALAM PONDASI)" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="l_o (mm):" Style="{StaticResource Lbl}"/><TextBox x:Name="ColTieLoBox" Text="100" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Mid (mm):" Style="{StaticResource Lbl}"/><TextBox x:Name="ColTieMidBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Pondasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="ColTieFoundBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Kaki:" Style="{StaticResource Lbl}"/><ComboBox x:Name="ColTieLegsCombo" SelectionChanged="OnRuleChanged"><ComboBoxItem Content="2"/><ComboBoxItem Content="4" IsSelected="True"/></ComboBox></DockPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="ColCrankCheck" Content="Tekukan 1:6 saat dimensi kolom mengecil" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <CheckBox x:Name="ColFoundTiesCheck" Content="Sengkang pengekang di dalam pondasi" IsChecked="True" Click="OnRuleCheckChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: PONDASI (FOUNDATION) -->
                        <TabItem Header="Pondasi">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,4,2">
                                <StackPanel>
                                    <Border Background="#2D1F0B" BorderBrush="#B45309" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#FDE68A"
                                                   Text="Murni Footplate / Pile Cap tanpa stek kolom (stek kolom sudah masuk di tab Kolom agar bebas double-count BBS)."/>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Selimut Tanah (mm):" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="FoundCoverBox" Grid.Column="1" Text="75" LostFocus="OnRuleTextLostFocus"/>
                                    </Grid>

                                    <TextBlock Text="MAT BAWAH (X &amp; Y)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Bawah-X:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FoundBotXDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FoundBotXSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Bawah-Y:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FoundBotYDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FoundBotYSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <CheckBox x:Name="FoundTopMeshCheck" Content="Aktifkan Tulangan Atas (Top Mesh X &amp; Y)" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <UniformGrid Columns="2" Margin="0,2,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Atas-X:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FoundTopXDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FoundTopXSpBox" Text="200" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Atas-Y:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FoundTopYDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FoundTopYSpBox" Text="200" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="TEKUKAN TEPI &amp; PENGIKAT" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <ComboBox x:Name="FoundEdgeTermCombo" Margin="0,0,4,0" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="Kait 90°" Tag="Bend90" IsSelected="True"/>
                                            <ComboBoxItem Content="U-Bar Loop" Tag="UBarLoop"/>
                                            <ComboBoxItem Content="Lurus" Tag="Straight"/>
                                        </ComboBox>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Kaki:" Style="{StaticResource Lbl}"/><TextBox x:Name="FoundHookLegBox" Text="250" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="FoundPerimBinderCheck" Content="Sengkang Keliling Tepi (Perimeter Binder)" IsChecked="False" Click="OnRuleCheckChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: PELAT (FLOOR) -->
                        <TabItem Header="Pelat">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,4,2">
                                <StackPanel>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Cover:" Style="{StaticResource Lbl}"/><TextBox x:Name="FloorCoverBox" Text="20" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                        <ComboBox x:Name="FloorLayoutModeCombo" Margin="4,0,0,0" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="Segmen ≤ 12m" Tag="Segmented12mMax" IsSelected="True"/>
                                            <ComboBoxItem Content="Full Extent" Tag="FullExtent"/>
                                        </ComboBox>
                                    </UniformGrid>

                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Tulangan Atas:" Style="{StaticResource Lbl}"/>
                                        <ComboBox x:Name="FloorTopModeCombo" Grid.Column="1" SelectionChanged="OnRuleChanged">
                                            <ComboBoxItem Content="Strip Tumpuan (L/4)" Tag="SupportStripL4" IsSelected="True"/>
                                            <ComboBoxItem Content="Full Double Mesh" Tag="FullDoubleMesh"/>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock Text="LAPISAN BAWAH (X &amp; Y)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Bawah-X:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FloorBotXDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FloorBotXSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Bawah-Y:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FloorBotYDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FloorBotYSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <TextBlock Text="LAPISAN ATAS (X &amp; Y)" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Atas-X:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FloorTopXDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FloorTopXSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,6">
                                        <DockPanel Margin="0,0,4,0"><TextBlock Text="Atas-Y:" Style="{StaticResource Lbl}"/><ComboBox x:Name="FloorTopYDiaCombo" SelectionChanged="OnRuleChanged"/></DockPanel>
                                        <DockPanel Margin="4,0,0,0"><TextBlock Text="Spasi:" Style="{StaticResource Lbl}"/><TextBox x:Name="FloorTopYSpBox" Text="150" LostFocus="OnRuleTextLostFocus"/></DockPanel>
                                    </UniformGrid>

                                    <CheckBox x:Name="FloorEdgeHookCheck" Content="Kait 90° pada tepi pelat" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <CheckBox x:Name="FloorTrimVoidCheck" Content="Potong otomatis sekitar lubang void" IsChecked="True" Click="OnRuleCheckChanged"/>
                                    <CheckBox x:Name="FloorDiagTrimCheck" Content="Tulangan diagonal 45° sudut void (2×D13)" IsChecked="True" Click="OnRuleCheckChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: 5 KPIs + LIVE 3D VIEWPORT / 2D CAD / BBS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 5 KPI CARDS -->
                <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,-8,8">
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL BERAT BAJA" FontSize="9.5" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiSteelKgText" Text="0.0 kg" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="VOLUME BETON" FontSize="9.5" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiConcreteM3Text" Text="0.00 m³" FontSize="17" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="RASIO TULANGAN" FontSize="9.5" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiRatioText" Text="0.0 kg/m³" FontSize="17" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="MAX POTONG BATANG" FontSize="9.5" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiMaxBarText" Text="0 mm" FontSize="17" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="OVERLAP / BATANG" FontSize="9.5" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            <TextBlock x:Name="KpiOverlapsText" Text="0 / 0 btg" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- MULTI-VIEW PREVIEW PANEL -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0">
                    <TabControl x:Name="PreviewTabControl" Background="Transparent" BorderThickness="0" SelectionChanged="OnPreviewTabChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#132238"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#26394F" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1B3654"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- VIEW 1: NATIVE 3D VIEWPORT -->
                        <TabItem Header="3D Model + Rebar Preview">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button Content="ISO" Style="{StaticResource FlatBtn}" Padding="8,3" Margin="0,0,4,0" Click="OnCameraPresetClick" Tag="ISO"/>
                                        <Button Content="Front" Style="{StaticResource FlatBtn}" Padding="8,3" Margin="0,0,4,0" Click="OnCameraPresetClick" Tag="FRONT"/>
                                        <Button Content="Side" Style="{StaticResource FlatBtn}" Padding="8,3" Margin="0,0,4,0" Click="OnCameraPresetClick" Tag="SIDE"/>
                                        <Button Content="Top" Style="{StaticResource FlatBtn}" Padding="8,3" Margin="0,0,4,0" Click="OnCameraPresetClick" Tag="TOP"/>
                                        <Button Content="Fit" Style="{StaticResource FlatBtn}" Padding="8,3" Margin="0,0,10,0" Click="OnFitCameraClick"/>
                                        <CheckBox x:Name="ShowConcreteCheck" Content="Beton" IsChecked="True" Margin="0,0,8,0" Click="OnViewportDisplayOptionChanged"/>
                                        <CheckBox x:Name="ShowRebarCheck" Content="Tulangan" IsChecked="True" Margin="0,0,8,0" Click="OnViewportDisplayOptionChanged"/>
                                        <CheckBox x:Name="ShowStirrupsCheck" Content="Sengkang" IsChecked="True" Margin="0,0,10,0" Click="OnViewportDisplayOptionChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Transparansi Beton:" Style="{StaticResource Lbl}"/>
                                        <Slider x:Name="ConcreteOpacitySlider" Width="95" Minimum="0.05" Maximum="0.80" Value="0.30" ValueChanged="OnConcreteOpacityChanged"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border x:Name="ViewportHostBorder"
                                        Grid.Row="1"
                                        Background="#070D17"
                                        BorderBrush="#1E3048"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True"
                                        MouseDown="OnViewportMouseDown"
                                        MouseMove="OnViewportMouseMove"
                                        MouseUp="OnViewportMouseUp"
                                        MouseWheel="OnViewportMouseWheel">
                                    <Grid>
                                        <Viewport3D x:Name="MainViewport3D">
                                            <Viewport3D.Camera>
                                                <PerspectiveCamera x:Name="MainCamera3D" FieldOfView="42"/>
                                            </Viewport3D.Camera>
                                            <ModelVisual3D x:Name="SceneModelVisual"/>
                                        </Viewport3D>
                                        <TextBlock Text="Left-Drag: Orbit  •  Right-Drag: Pan  •  Wheel: Zoom"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,10,8"
                                                   FontSize="10.5"
                                                   Foreground="#64748B"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- VIEW 2: 2D LONGITUDINAL / ELEVATION -->
                        <TabItem Header="2D Potongan Memanjang / Elevasi">
                            <Border Background="#070D17" BorderBrush="#1E3048" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" ClipToBounds="True">
                                <Canvas x:Name="ElevationCanvas" Background="Transparent" SizeChanged="OnCadCanvasSizeChanged"/>
                            </Border>
                        </TabItem>

                        <!-- VIEW 3: 2D SECTION / PLAN -->
                        <TabItem Header="2D Penampang / Denah">
                            <Border Background="#070D17" BorderBrush="#1E3048" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" ClipToBounds="True">
                                <Canvas x:Name="SectionPlanCanvas" Background="Transparent" SizeChanged="OnCadCanvasSizeChanged"/>
                            </Border>
                        </TabItem>

                        <!-- VIEW 4: LIVE BBS TABLE & WARNINGS -->
                        <TabItem Header="Live BBS &amp; Audit">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="95"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="BbsDataGrid"
                                          Grid.Row="0"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="#070D17"
                                          Foreground="#E2E8F0"
                                          RowBackground="#0F1A2B"
                                          AlternatingRowBackground="#122033"
                                          BorderBrush="#24364E"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1D2D44"
                                          HeadersVisibility="Column"
                                          FontSize="11.5">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#132238"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="7,5"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="78"/>
                                        <DataGridTextColumn Header="Host" Binding="{Binding HostTag}" Width="66"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
                                        <DataGridTextColumn Header="Shape" Binding="{Binding ShapeCode}" Width="54"/>
                                        <DataGridTextColumn Header="Dia" Binding="{Binding DiameterMm}" Width="46"/>
                                        <DataGridTextColumn Header="Potong (mm)" Binding="{Binding CutLengthMm, StringFormat=N0}" Width="84"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="48"/>
                                        <DataGridTextColumn Header="Total (m)" Binding="{Binding TotalLengthM, StringFormat=N2}" Width="72"/>
                                        <DataGridTextColumn Header="Berat (kg)" Binding="{Binding TotalWeightKg, StringFormat=N2}" Width="78"/>
                                        <DataGridTextColumn Header="Catatan" Binding="{Binding Notes}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="1" Background="#131926" BorderBrush="#26394F" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="ENGINEERING WARNINGS / AUDIT LOG" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,4"/>
                                        <ListBox x:Name="WarningsListBox" Background="Transparent" BorderThickness="0" Foreground="#FDE68A" FontSize="11"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 3: BOTTOM ACTION BAR -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0" Padding="10,7">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Left"
                           Text="Siap — Pilih elemen Balok / Kolom / Pondasi / Pelat di Revit untuk melihat live preview."
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           MaxWidth="450"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Smart Mark" Style="{StaticResource FlatBtn}" Margin="0,0,6,0" Click="OnSmartMarkClick"/>
                    <Button Content="Auto-Tag" Style="{StaticResource FlatBtn}" Margin="0,0,6,0" Click="OnAutoTagClick"/>
                    <Button Content="Revit BBS" Style="{StaticResource FlatBtn}" Margin="0,0,6,0" Click="OnCreateBbsClick"/>
                    <Button Content="Export CSV/BVBS" Style="{StaticResource FlatBtn}" Margin="0,0,10,0" Click="OnExportBbsClick"/>
                    <Button x:Name="GenerateBtn" Content="⚡ Generate Rebar on Selected" Style="{StaticResource PrimaryCtaBtn}" Click="OnGenerateRebarClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
