<Window x:Class="Aigrav.RenderStudio.UI.Views.MainRendererWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AIGRAV Render Studio — Precision AI Visualizer (Revit 2026)"
        Width="1480" Height="880"
        MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0D0F14"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI, Inter"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ==================== PALET WARNA DARK STUDIO ==================== -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0D0F14"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="#151922"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#1C222E"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="#11141C"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A3244"/>
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#818CF8"/>
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ==================== STYLE TOMBOL UTAMA ==================== -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE TOMBOL SEKUNDER ==================== -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262E3E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE TOMBOL WINDOW (MIN / MAX / CLOSE) ==================== -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#262E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1C222E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE INPUT TEXTBOX DARK ==================== -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE COMBOBOX DARK ==================== -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ==================== STYLE RADIOBUTTON MODE SELECTOR ==================== -->
        <Style x:Key="ModeCardRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder" Background="{StaticResource BgInputBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="indicator" Width="12" Height="12"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#1E1B4B"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="indicator" Property="Fill" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="indicator" Property="Stroke" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== STYLE DATAGRID DARK ==================== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#12151E"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#171B26"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#232938"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2535"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#252B42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ==================== ROOT LAYOUT ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Top Header Bar -->
            <RowDefinition Height="*"/>    <!-- 3-Column Workspace -->
            <RowDefinition Height="64"/>   <!-- Bottom Action & Progress Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Active View Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentPrimaryBrush}" CornerRadius="5" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="AIGRAV" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                    <TextBlock Text="RENDER STUDIO" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    
                    <!-- Dynamic View Selection Dropdown -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target View:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTargetView"
                                      ItemsSource="{Binding AvailableViews}"
                                      SelectedItem="{Binding SelectedTargetView}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="240" MaxWidth="360"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      FontSize="11" Padding="8,4"/>
                            <Button x:Name="BtnRefreshViews" Command="{Binding RefreshViewsCommand}"
                                    ToolTip="Deteksi Ulang View Aktif Revit (Refresh)"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0,2,0" Padding="4">
                                <TextBlock Text="🔄" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#132A22" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="3840 x 2160 • 4K Lossless PNG" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Bridge Status Pill & Window Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BridgeStatusText, FallbackValue='AIGRAV MCP Bridge: Connected (Port 8765)'}"
                                       FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,10,0"/>

                    <!-- Window Controls: Minimize, Maximize / Restore, Close -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="Minimize (Kecilkan)" Click="BtnMinimize_Click">
                            <Path Data="M 0 6 L 10 6" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="Maximize / Restore (Perbesar / Normal)" Click="BtnMaximize_Click" Margin="4,0,0,0">
                            <Grid Width="10" Height="10">
                                <Rectangle x:Name="IconSquareNormal" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"/>
                                <Canvas x:Name="IconSquareMaximized" Visibility="Collapsed" Width="10" Height="10">
                                    <Path Data="M 2 0 L 10 0 L 10 8 M 0 2 L 8 2 L 8 10 L 0 10 Z"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2"/>
                                </Canvas>
                            </Grid>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButtonStyle}"
                                ToolTip="Close (Tutup - Esc)" Click="BtnClose_Click" Margin="4,0,0,0">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN 3-COLUMN WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/> <!-- Left: Engine, Model & Style Config -->
                <ColumnDefinition Width="*"/>   <!-- Center: Before/After Split Viewport & 3-Pass Strip -->
                <ColumnDefinition Width="460"/> <!-- Right: Material ID RGB Map Table -->
            </Grid.ColumnDefinitions>

            <!-- ==================== KOLOM KIRI: KONFIGURASI ENGINE & STYLE ==================== -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- SECTION A: EXECUTION ROUTING MODE -->
                        <TextBlock Text="1. EXECUTION ROUTING" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <RadioButton x:Name="RbBridgeMode" GroupName="ExecMode" IsChecked="{Binding IsBridgeModeSelected, FallbackValue=True}"
                                     Style="{StaticResource ModeCardRadioButtonStyle}" Checked="ExecutionMode_Changed">
                            <StackPanel>
                                <TextBlock Text="Send via Antigravity Bridge (MCP)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Kirim 3-Pass 4K + JSON Material Map langsung ke workspace Google Antigravity aktif."
                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbDirectApiMode" GroupName="ExecMode" IsChecked="{Binding IsDirectApiModeSelected}"
                                     Style="{StaticResource ModeCardRadioButtonStyle}" Checked="ExecutionMode_Changed">
                            <StackPanel>
                                <TextBlock Text="Direct Multi-Model API Key (BYOK)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Kirim langsung ke endpoint resmi Gemini, OpenAI ChatGPT, atau xAI Grok."
                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- SECTION B: AI MODEL & API KEY CONFIGURATION -->
                        <Border x:Name="DirectApiConfigPanel" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,6,0,16">
                            <StackPanel>
                                <TextBlock Text="TARGET AI GENERATOR MODEL" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                                <ComboBox x:Name="CmbAiModel" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Google Gemini — gemini-3-pro-image (Nano Banana Pro 4K)" Tag="gemini-3-pro-image"/>
                                    <ComboBoxItem Content="Google Gemini — gemini-nano-banana-2.1 (Multi-Ref Fast)" Tag="gemini-nano-banana-2.1"/>
                                    <ComboBoxItem Content="OpenAI ChatGPT — gpt-image-2.6-sunburst (Max Precision)" Tag="gpt-image-2.6-sunburst"/>
                                    <ComboBoxItem Content="OpenAI ChatGPT — gpt-image-2.6-flare (Fast Concept)" Tag="gpt-image-2.6-flare"/>
                                    <ComboBoxItem Content="xAI Grok — grok-imagine-image-2.0 (Cinematic Lighting)" Tag="grok-imagine-image-2.0"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="API Key (DPAPI Encrypted)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Saved Locally" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <PasswordBox x:Name="PwdApiKey" Background="{StaticResource BgInputBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8,6" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION C: ARCHITECTURAL STYLE & REFERENCE IMAGE -->
                        <TextBlock Text="2. STYLE PRESET &amp; REFERENCE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>

                        <TextBlock Text="Preset Atmosfer &amp; Pencahayaan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="Industrial Factory &amp; Warehouse — Crisp Daylight"/>
                            <ComboBoxItem Content="Modern Commercial Facade — Overcast Soft Shadows"/>
                            <ComboBoxItem Content="Architectural Golden Hour — Warm Sun &amp; Sky"/>
                            <ComboBoxItem Content="Clean Interior PBR — Neutral Studio Illumination"/>
                            <ComboBoxItem Content="Heavy Infrastructure — Realistic Tropical Noon"/>
                        </ComboBox>

                        <!-- Upload Style Reference Card -->
                        <TextBlock Text="Custom Style Reference Image (Opsional)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="110"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="#161A24" CornerRadius="4" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="ImgStyleReference" Source="{Binding StyleReferenceImageSource}" Stretch="UniformToFill"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Drop atau Pilih Foto Referensi Mood/Lighting"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"/>
                                            <TextBlock Text="(Digunakan sebagai panduan pencahayaan &amp; tone)"
                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Browse Reference Image..." Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseStyleImageCommand}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearStyleImageCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- SECTION D: ANTI-HALLUCINATION LOCKS -->
                        <TextBlock Text="3. GEOMETRY &amp; ZERO-HALLUCINATION LOCKS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>

                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox IsChecked="True" IsEnabled="False" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="11.5" Margin="0,0,0,8">
                                    <TextBlock Text="🔒 Zero-Additions: Dilarang Menambah Pohon, Orang, Mobil, atau Objek Fiktif" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="True" IsEnabled="False" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="11.5" Margin="0,0,0,8">
                                    <TextBlock Text="🛡️ Zero-Deletions: Kunci 100% Struktur Asli (Kolom, Balok, Dinding, Kusen)" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,0,0,8">
                                    <TextBlock Text="🎨 PBR Material Mapping dari Filter Color Mask Pass" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5">
                                    <TextBlock Text="📐 Kunci Sudut Cahaya &amp; Bayangan dari Shaded Color Pass" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Global Scene Prompt Addition" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBoxStyle}" Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding GlobalSceneNotes, FallbackValue='Photorealistic architectural photography, 24mm tilt-corrected lens, realistic structural proportions, crisp PBR material fidelity, zero structural hallucination.'}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== KOLOM TENGAH: INTERACTIVE BEFORE/AFTER VIEWPORT ==================== -->
            <Grid Grid.Column="1" Background="#090B0E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>     <!-- Main Split Viewport -->
                    <RowDefinition Height="148"/>   <!-- 3-Pass Export Thumbnail Strip -->
                </Grid.RowDefinitions>

                <!-- MAIN SPLIT COMPARE CANVAS -->
                <Border Grid.Row="0" Margin="16,16,16,8" Background="#12151E"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid x:Name="ViewportCompareContainer" SizeChanged="ViewportCompareContainer_SizeChanged">

                        <!-- LAYER BAWAH: AFTER (HASIL AI RENDER 4K) -->
                        <Grid Background="#0E1117">
                            <Image x:Name="ImgAfterRender" Source="{Binding AfterRenderImage}" Stretch="Uniform"/>
                            <TextBlock Text="Hasil Render AI 4K akan tampil di sini setelah proses eksekusi selesai"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- LAYER ATAS: BEFORE (REVIT 3-PASS / MATERIAL MASK) DENGAN DYNAMIC CLIP -->
                        <Grid x:Name="BeforeImageLayer" Background="#141821">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="BeforeClipGeometry" Rect="0,0,450,600"/>
                            </Grid.Clip>
                            <Image x:Name="ImgBeforeRevit" Source="{Binding BeforePreviewImage}" Stretch="Uniform"/>
                            <TextBlock Text="Klik '1. Capture 3-Pass 4K' untuk mengekstrak view dari Revit"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- GARIS PEMBATAS VERTIKAL WIPE LINE -->
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="SplitDividerLine" Width="2" Background="White"
                                    Height="{Binding ActualHeight, ElementName=ViewportCompareContainer}"
                                    Canvas.Left="450"/>
                        </Canvas>

                        <!-- FLOATING BADGE KIRI: BEFORE -->
                        <Border Background="#CC11141C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="BEFORE: REVIT 4K PASS" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- FLOATING BADGE KANAN: AFTER -->
                        <Border Background="#CC1E1B4B" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="AFTER: AI PRECISION 4K RENDER" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- SLIDER PENGONTROL BEFORE / AFTER WIPE -->
                        <Border Background="#D9151922" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="16,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Width="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Revit" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SplitCompareSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50"
                                        VerticalAlignment="Center" ValueChanged="SplitCompareSlider_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="AI 4K" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- BOTTOM STRIP: 3-PASS 4K THUMBNAIL INSPECTOR -->
                <Border Grid.Row="1" Margin="16,4,16,16" Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pass 1 Card: View Saat Ini dengan Material -->
                        <Border Grid.Column="0" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="PASS 1: VIEW SAAT INI (MATERIAL)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Material Asli" FontSize="9.5" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Border Grid.Row="1" Background="#0D0F14" CornerRadius="4">
                                    <Image Source="{Binding LightingPassThumbnail}" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pass 2 Card: View dengan Filter Color Material -->
                        <Border Grid.Column="1" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource AccentPrimaryBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,3,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="PASS 2: FILTER COLOR MATERIAL" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Semantic Mask" FontSize="9.5" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Border Grid.Row="1" Background="#0D0F14" CornerRadius="4">
                                    <Image Source="{Binding MaterialIdPassThumbnail}" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pass 3 Card: View dengan Shaded Color -->
                        <Border Grid.Column="2" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="PASS 3: SHADED COLOR (4K)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Depth &amp; Shadows" FontSize="9.5" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Border Grid.Row="1" Background="#0D0F14" CornerRadius="4">
                                    <Image Source="{Binding GeometryPassThumbnail}" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== KOLOM KANAN: TABEL MATERIAL ID MAP ==================== -->
            <Border Grid.Column="2" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Material ID Map -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="MATERIAL ID SEGMENTATION MAP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Warna Solid Fill sementara via Transaction.RollBack()" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="Auto-Generate PBR Prompts" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AutoEnrichMaterialPromptsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Filter Pencarian Material -->
                    <TextBox x:Name="TxtFilterMaterial" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}"
                             Tag="Cari nama material Revit atau kode warna Hex..." Margin="0,0,0,10"/>

                    <!-- Tabel DataGrid Material ID -->
                    <DataGrid x:Name="GridMaterialMap" Grid.Row="2"
                              ItemsSource="{Binding DetectedMaterials}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{StaticResource BgInputBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              BorderThickness="1"
                              RowHeight="44"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Kolom 1: Kotak Warna Masker RGB + Kode Hex -->
                            <DataGridTemplateColumn Header="MASK RGB" Width="92" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Border Width="20" Height="20" CornerRadius="4"
                                                    Background="{Binding HexColor}"
                                                    BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding HexColor}" FontFamily="Consolas" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom 2: Nama Material di Revit & Class -->
                            <DataGridTemplateColumn Header="REVIT MATERIAL" Width="135" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding RevitName}" FontWeight="SemiBold" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RevitName}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MaterialClass}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text=" • Glass Mask" FontSize="10" Foreground="#38BDF8"
                                                           Visibility="{Binding WasTransparent, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kolom 3: Deskripsi Prompt AI per Material (Editable) -->
                            <DataGridTemplateColumn Header="AI PBR PROMPT DESCRIPTOR (EDITABLE)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AiPromptDescriptor, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#12151E" Foreground="#E5E7EB"
                                                 BorderBrush="#2E364A" BorderThickness="1"
                                                 Padding="6,4" Margin="6,4" FontSize="11"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Info JSON Map -->
                    <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="JSON Payload:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MaterialJsonPath, FallbackValue='.aigrav/render_jobs/latest/material_map.json'}"
                                       FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource AccentEmeraldBrush}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BOTTOM STATUS & ACTION BAR ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pipeline Status & Progress Bar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="8" Value="{Binding ProgressPercentage, FallbackValue=100}"
                                 Background="{StaticResource BgInputBrush}" Foreground="{StaticResource AccentEmeraldBrush}"
                                 BorderThickness="0" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready — Model Revit aman (Transaction.RollBack terverifikasi).'}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tombol Eksekusi Utama -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1. Capture 3-Pass 4K (Revit)" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CaptureThreePassCommand}" Margin="0,0,10,0" Padding="16,10"/>

                    <Button Content="2. Execute AI Precision Render" Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding ExecuteAiRenderCommand}" Margin="0,0,10,0"/>

                    <Button Content="Save 4K PNG" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveOutputImageCommand}" Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
