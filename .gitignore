STT/models/*.bin
*.mdf
*.ldf
*.sqlite3

# Audio & Temporary runtime cache
audio_cache/
Temp/
temp/
scratch/
references/
*.wav
*.mp3
*.bak*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large Revit project models (keep templates/families in ConnectionLibrary)
*.rvt
*.rws
