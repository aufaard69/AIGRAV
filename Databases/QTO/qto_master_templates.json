  ],
  "universal_rules": {
    "column_a_parameter": "Lokasi",
    "dual_key_filter_standard": {
      "steel_connections_all": {
        "applies_to": [
          "OST_StructConnections",
          "OST_StructConnectionPlates",
          "OST_StructConnectionBolts",
          "OST_StructConnectionAnchors",
          "OST_StructConnectionProfiles",
          "OST_StructConnectionWelds",
          "OST_StructConnectionShearStuds"
        ],
        "includes_modes": [
          "Custom Advance Steel Connection",
          "Manual / Exploded Connection"
        ],
        "primary_filters": [
          "Lokasi",
          "Type of Connection"
        ],
        "shared_parameter_binding_10_categories": [
          "OST_StructConnections",
          "OST_StructConnectionPlates",
          "OST_StructConnectionBolts",
          "OST_StructConnectionAnchors",
          "OST_StructConnectionProfiles",
          "OST_StructConnectionWelds",
          "OST_StructConnectionShearStuds",
          "OST_StructConnectionModifiers",
          "OST_StructConnectionHoles",
          "OST_StructConnectionOthers"
        ]
      },
      "non_connection_elements_all": {
        "applies_to": [
          "Foundation/Pile/Pilecap",
          "Concrete Beams/Columns/Slabs/Walls",
          "Formwork",
          "Primary/Secondary Steel Profiles",
          "Roof/Flashing/Cladding",
          "Doors/Windows/Ceilings/Railings",
          "Siteplan DPT/Rabat/Kanstin/Pipes",
          "Rebar"
        ],
        "primary_filters": [
          "Lokasi",
          "Comments"
        ],
        "secondary_material_takeoff_filter": "Material: Name",
        "forbid_elemid_filters": true,
        "forbid_negative_notequal_filters": true
      }
    },
    "anti_double_counting": {
      "main_building_lokasi_value": "Bangunan Utama (or Lokasi == '')",
      "sub_zone_filter": "Lokasi Equal '<ZoneName>'",
      "derived_multi_qto_exemptions": [
        "Formwork/Bekisting paired with Concrete Volume",
        "Reference Door/Window Schedules vs BOQ Volume Schedules",
        "Material Takeoffs splitting distinct material layers (Bata vs Plester Aci)",
        "1-Railing-3-QTO derived schedules (Pagar + Sloof + Stump)"
      ]
    },
    "wbs_anti_duplicate_numbering": {
      "require_unique_wbs_prefix": true,
      "triplet_suffix_convention": {
        "concrete": "a",
        "lean_concrete": "b",
        "rebar": "c"
      }
    },
    "qa_12_gates": [
      "unscheduled_elements",
      "double_counting",
      "spatial_duplicates",
      "empty_schedules_with_typo_diagnosis",
      "filter_errors_and_cross_contamination",
      "unit_and_heading_errors",
      "calculation_errors_totals_and_bolt_number",
      "steel_weight_calibration",
      "connection_parameter_injection_and_voute",
      "wbs_numbering_hygiene",
      "geometry_and_param_health",
      "engineering_sanity_rebar_ratio"
    ]
  },
